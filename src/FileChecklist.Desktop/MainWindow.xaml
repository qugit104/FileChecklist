<Window x:Class="FileChecklist.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:FileChecklist.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc '清单交付'}" Style="{StaticResource {x:Type Window}}" Width="1240" Height="780" MinWidth="1020" MinHeight="620" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <DockPanel>
    <Menu x:Name="SideActions" DockPanel.Dock="Top" Background="#F5F5F5" Padding="8,3" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <MenuItem Header="{local:Loc '文件(_F)'}"><MenuItem Header="{local:Loc '新建清单…'}" Click="New_Click"/><MenuItem Header="{local:Loc '打开任务…'}" Click="Open_Click"/><MenuItem Header="{local:Loc '保存任务…'}" Click="Save_Click"/><Separator/><MenuItem Header="{local:Loc '恢复最近任务'}" Click="Recovery_Click"/></MenuItem>
      <MenuItem Header="{local:Loc '帮助(_H)'}"><MenuItem Header="{local:Loc '使用说明'}" Click="Help_Click"/><MenuItem Header="{local:Loc '打开示例'}" Click="Demo_Click"/></MenuItem>
    </Menu>
    <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,5">
      <DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="{local:Loc '取消'}" Click="Cancel_Click" Padding="10,2" Visibility="Collapsed" Margin="8,0,0,0"/><ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="100" Height="4" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusLine" Text="{local:Loc '就绪'}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <StackPanel x:Name="TopActions" DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="DeliverButton" Content="{local:Loc '复制到目标文件夹…'}" Style="{StaticResource Primary}" Click="Deliver_Click" Margin="0" IsEnabled="False"/></StackPanel>
        <StackPanel x:Name="ScanActions" Orientation="Horizontal"><Button Content="{local:Loc '导入清单…'}" Click="New_Click"/><Button Content="{local:Loc '打开任务…'}" Click="Open_Click"/><Button Content="{local:Loc '保存'}" Click="Save_Click"/><Border Width="1" Background="{StaticResource Line}" Margin="4,3,12,3"/><Button x:Name="ScanButton" Content="{local:Loc '扫描文件'}" Click="Scan_Click"/><Button x:Name="IssuesButton" Content="{local:Loc '扫描问题'}" Click="Issues_Click"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Margin="12,10,12,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="FolderActions" Margin="0,0,0,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{local:Loc '查找位置'}" VerticalAlignment="Center"/><ComboBox x:Name="RootsBox" Grid.Column="1" Margin="0,0,8,6" ToolTip="{local:Loc '扫描这些文件夹及其子文件夹。'}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6"><Button Content="{local:Loc '添加…'}" Click="AddRoot_Click"/><Button Content="{local:Loc '移除'}" Click="RemoveRoot_Click" Margin="0"/></StackPanel>
        <TextBlock Grid.Row="1" Text="{local:Loc '复制到'}" VerticalAlignment="Center"/><TextBox x:Name="OutputBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0"/><Button Grid.Row="1" Grid.Column="2" Content="{local:Loc '浏览…'}" Click="Output_Click" Margin="0"/>
      </Grid>
      <DockPanel Grid.Row="1" Margin="0,3,0,9">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" TextBlock.Foreground="{StaticResource Muted}"><TextBlock Text="{local:Loc '共 '}"/><TextBlock x:Name="TotalCount"/><TextBlock Text="{local:Loc ' 项    待复制 '}"/><TextBlock x:Name="ReadyCount"/><TextBlock Text="{local:Loc '    待处理 '}"/><TextBlock x:Name="ProblemCount"/><TextBlock Text="{local:Loc '    已完成 '}"/><TextBlock x:Name="DoneCount"/></StackPanel>
        <TextBlock x:Name="TaskTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,15,0"/>
      </DockPanel>
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0" Background="#F5F5F5" Padding="8,6"><StackPanel Orientation="Horizontal"><TextBlock Text="{local:Loc '显示'}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="FilterBox" Width="112" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,20,0"><ComboBoxItem Content="{local:Loc '全部项目'}"/><ComboBoxItem Content="{local:Loc '待处理'}"/><ComboBoxItem Content="{local:Loc '待复制'}"/><ComboBoxItem Content="{local:Loc '已完成'}"/></ComboBox><TextBlock Text="{local:Loc '筛选'}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="SearchBox" Width="230" ToolTip="{local:Loc '输入文件名、备注或路径'}" TextChanged="Search_Changed"/></StackPanel></Border>
      <Grid Grid.Row="3">
        <DataGrid x:Name="RowsGrid" SelectionChanged="Rows_SelectionChanged"><DataGrid.Columns>
          <DataGridTextColumn Header="{local:Loc '行号'}" Binding="{Binding Number}" Width="50"/><DataGridTextColumn Header="{local:Loc '文件名'}" Binding="{Binding Name}" Width="220" ElementStyle="{StaticResource CellText}"/>
          <DataGridTemplateColumn Header="{local:Loc '状态'}" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding Ink}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="{local:Loc '原始清单'}" Binding="{Binding Original}" Width="260" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="{local:Loc '说明'}" Binding="{Binding Detail}" Width="*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
        </DataGrid.Columns></DataGrid>
        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"><TextBlock Text="{local:Loc '尚未导入清单'}" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="{local:Loc '从 Excel 复制文件名列，或导入 CSV / TSV 文件。'}" Foreground="{StaticResource Muted}" Margin="0,8,0,16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="{local:Loc '导入清单…'}" Click="New_Click"/><Button Content="{local:Loc '打开示例'}" Click="Demo_Click" Margin="0"/></StackPanel></StackPanel>
      </Grid>
      <Border Grid.Row="4" Padding="0,12,0,0" x:Name="CandidatePanel" Visibility="Collapsed"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="CandidateActions"><Button Content="{local:Loc '使用选中文件'}" Click="Choose_Click"/><Button Content="{local:Loc '打开所在文件夹'}" Click="Reveal_Click" Margin="0"/></StackPanel><TextBlock x:Name="SelectedLabel" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/></DockPanel>
        <ListView x:Name="CandidatesBox" Grid.Row="1" Height="104" BorderBrush="{StaticResource Line}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="{local:Loc '文件位置'}" Width="740"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="{local:Loc '大小'}" Width="100" DisplayMemberBinding="{Binding Size}"/><GridViewColumn Header="{local:Loc '修改时间'}" Width="160" DisplayMemberBinding="{Binding Modified}"/></GridView></ListView.View></ListView>
        <TextBlock x:Name="SelectedDetail" Grid.Row="2" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Grid></Border>
    </Grid>
  </DockPanel>
</Window>
